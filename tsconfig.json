{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "module": "esnext",
    "strict": false
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "preserveWhitespaces": true,
    "strictTemplates": false
  },
  "files": ["src/main.ts"]
}
