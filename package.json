{
  "name": "kdos-daniel-web",
  "version": "2.0.0-rc.0",
  "description": "Kdos daniel web app",
  "scripts": {
    "ng": "ng",
    "serve": "echo \"node version : $(node --version)\" && ng serve",
    "dev": "yarn run serve",
    "build": "ng build --configuration production",
    "htmllint": " htmllint 'src/app/**/*.html'",
    "eslint": "eslint",
    "eslint:apply": "eslint --fix",
    "format": "prettier --write '{,@(src|test)/**/}*.*'",
    "lint": "npm run htmllint && npm run eslint",
    "test": "echo 'no tests'",
    "release": "export BABEL_DISABLE_CACHE=1 && release-it --ci",
    "release:dry": "export BABEL_DISABLE_CACHE=1 && release-it --ci --dry-run=true",
    "package": "rm -rf build/*.tar && npm run build && tar cf build/$npm_package_name-v$npm_package_version.tar dist/*",
    "build:changelog": "conventional-changelog -i CHANGELOG.md -s -p eslint -r 0",
    "post:release": "echo Successfully released $npm_package_version",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.5",
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "@angular/platform-browser": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@ng-select/ng-select": "^24.2.1",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@nth-cloud/ng-toggle": "^11.0.0",
    "angulartics2": "^14.1.0",
    "bootstrap": "^5.3.8",
    "font-awesome": "4.7.0",
    "linkify-string": "^4.4.0",
    "linkifyjs": "^4.4.0",
    "lodash": "^4.18.1",
    "ngx-bootstrap": "^22.0.0",
    "rxjs": "~7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/lodash": "^4.17.27",
    "angular-eslint": "^22.6.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-eslint": "^6.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "htmllint-cli": "^0.0.7",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
